{
  "name": "building-operator-mvp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "npm run typecheck && npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server-build.json",
    "build:web": "vite build --config vite.config.ts",
    "contracts:generate": "tsx scripts/contracts/generate-json-schema.ts",
    "contracts:check": "tsx scripts/contracts/generate-json-schema.ts --check",
    "data:floor": ".venv/bin/python scripts/data-pipeline/extract_floor.py --ifc data/source/west-riverside-arc-ifc2x3.ifc --storey 'Level 1' --output data/generated/west-riverside-level-1.scene.json",
    "data:audit": ".venv/bin/python scripts/data-pipeline/audit_ifc.py --output reports/ifc-audit.json",
    "data:floors": ".venv/bin/python scripts/data-pipeline/prepare_floors.py",
    "data:devices": ".venv/bin/python scripts/data-pipeline/generate_devices.py --count 18000 --output data/generated/west-riverside.devices-18000.json.gz --manifest data/generated/west-riverside.devices-18000.manifest.json",
    "data:stress": ".venv/bin/python scripts/data-pipeline/generate_devices.py --count 50000 --output data/generated/west-riverside.devices-50000.json.gz --manifest data/generated/west-riverside.devices-50000.manifest.json",
    "data:validate": "tsx scripts/data-pipeline/validate_floors.ts && tsx scripts/data-pipeline/validate_catalog.ts data/generated/west-riverside.devices-18000.json.gz data/generated/west-riverside.devices-18000.manifest.json && tsx scripts/data-pipeline/validate_catalog.ts data/generated/west-riverside.devices-50000.json.gz data/generated/west-riverside.devices-50000.manifest.json",
    "data:reproducibility": "scripts/data-pipeline/check_reproducibility.sh",
    "start": "node dist/server/server/index.js",
    "start:api": "tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:performance:representative": "BUILDING_DEVICE_FIXTURE=representative playwright test --config playwright.performance.config.ts",
    "test:performance:stress": "BUILDING_DEVICE_FIXTURE=stress playwright test --config playwright.performance.config.ts",
    "test:performance": "npm run test:performance:representative && npm run test:performance:stress",
    "test:production": "scripts/smoke-production",
    "verify": "npm run contracts:check && npm run data:validate && npm run test && npm run build && npm run test:production"
  },
  "dependencies": {
    "@deck.gl/core": "^9.1.14",
    "@deck.gl/extensions": "^9.3.9",
    "@deck.gl/layers": "^9.1.14",
    "@deck.gl/react": "^9.1.14",
    "@fastify/compress": "^9.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@tanstack/react-query": "^5.101.4",
    "fastify": "^5.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
