#!/usr/bin/env bash
set -euo pipefail

task_port="4174"
task_log="$(mktemp -t building-operator-production.XXXXXX.log)"
scene_response="$(mktemp -t building-operator-scene.XXXXXX.json)"
catalog_response="$(mktemp -t building-operator-catalog.XXXXXX.json)"
snapshot_response="$(mktemp -t building-operator-snapshot.XXXXXX.json)"
command_response="$(mktemp -t building-operator-command.XXXXXX.json)"

PORT="$task_port" HOST="127.0.0.1" NODE_ENV="production" \
  node dist/server/server/index.js >"$task_log" 2>&1 &
server_pid="$!"

cleanup() {
  kill "$server_pid" 2>/dev/null || true
  wait "$server_pid" 2>/dev/null || true
  rm -f "$task_log" "$scene_response" "$catalog_response" "$snapshot_response" "$command_response"
}
trap cleanup EXIT

ready="false"
for _ in {1..40}; do
  if curl --fail --silent "http://127.0.0.1:${task_port}/api/health" >/dev/null; then
    ready="true"
    break
  fi
  sleep 0.25
done

if [[ "$ready" != "true" ]]; then
  sed -n '1,160p' "$task_log"
  echo "Production server did not become ready" >&2
  exit 1
fi

curl --fail --silent "http://127.0.0.1:${task_port}/" \
  | grep --quiet "Building scene prototype"

curl --fail --silent \
  -H 'content-type: application/json' \
  -d '{"floorId":"west-riverside-level-1","viewport":{"bbox":[0,0,104,98],"width":1200,"height":800},"zoom":5}' \
  "http://127.0.0.1:${task_port}/api/scene/query" \
  -o "$scene_response"

node -e '
  const response = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
  if (response.sceneVersion !== "west-riverside-stage-2-v2:west-riverside-level-1") process.exit(1);
  if (response.meta.returnedFeatures < 1000) process.exit(1);
' "$scene_response"

curl --fail --silent \
  "http://127.0.0.1:${task_port}/api/v1/catalog?buildingId=west-riverside&floorIds=west-riverside-level-7" \
  -o "$catalog_response"

node -e '
  const response = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
  if (response.catalogVersion !== "west-riverside-18000-seed-20260807-v1") process.exit(1);
  if (response.totalDevices !== 150 || response.devices.length !== 150) process.exit(1);
  if (response.devices.some((device) => device.floorId !== "west-riverside-level-7")) process.exit(1);
' "$catalog_response"

curl --fail --silent \
  "http://127.0.0.1:${task_port}/api/v1/state/snapshot?buildingId=west-riverside&floorIds=west-riverside-level-7" \
  -o "$snapshot_response"

node -e '
  const response = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
  if (!response.snapshotId.startsWith("stage-8-9-live-snapshot-v1:")) process.exit(1);
  if (!response.streamId.startsWith("stage-8-9-")) process.exit(1);
  if (!Number.isSafeInteger(response.sequence) || response.sequence < 0) process.exit(1);
  if (response.telemetry.length !== 150) process.exit(1);
  if (!response.telemetry.some((item) => item.status === "warning" || item.status === "critical")) process.exit(1);
' "$snapshot_response"

command_device_id="$(node -e '
  const response = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
  const device = response.devices.find((item) => item.capabilities.commands.some(
    (capability) => capability.kind === "setOnOff" && !capability.requiresConfirmation,
  ));
  if (!device) process.exit(1);
  process.stdout.write(device.id);
' "$catalog_response")"

curl --fail --silent \
  -H 'content-type: application/json' \
  -d "{\"clientRequestId\":\"production-smoke-command\",\"deviceId\":\"${command_device_id}\",\"intent\":{\"kind\":\"setOnOff\",\"value\":false},\"requestedAt\":\"2026-08-09T12:00:00.000Z\",\"requestedBy\":\"smoke-operator\",\"confirmation\":null}" \
  "http://127.0.0.1:${task_port}/api/v1/commands" \
  -o "$command_response"

node -e '
  const response = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
  if (!response.command?.id || response.command.state !== "pending") process.exit(1);
' "$command_response"

command_id="$(node -e '
  const response = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
  process.stdout.write(response.command.id);
' "$command_response")"

sleep 3

curl --fail --silent \
  "http://127.0.0.1:${task_port}/api/v1/commands/${command_id}" \
  -o "$command_response"

node -e '
  const response = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
  if (response.command?.state !== "executed") process.exit(1);
  if (!Number.isSafeInteger(response.command.resultTelemetryRevision)) process.exit(1);
' "$command_response"

curl --fail --silent \
  "http://127.0.0.1:${task_port}/api/v1/state/snapshot?buildingId=west-riverside&floorIds=west-riverside-level-7" \
  -o "$snapshot_response"

node -e '
  const fs = require("node:fs");
  const snapshot = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
  const command = JSON.parse(fs.readFileSync(process.argv[2], "utf8")).command;
  const telemetry = snapshot.telemetry.find((item) => item.deviceId === command.deviceId);
  if (!telemetry || telemetry.revision !== command.resultTelemetryRevision) process.exit(1);
  if (telemetry.values.on !== false) process.exit(1);
' "$snapshot_response" "$command_response"

node -e '
  const fs = require("node:fs");
  const snapshot = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
  const socket = new WebSocket(`ws://127.0.0.1:${process.argv[2]}/api/v1/realtime`);
  const timeout = setTimeout(() => {
    console.error("Timed out waiting for production realtime batch");
    process.exit(1);
  }, 5000);
  socket.addEventListener("open", () => socket.send(JSON.stringify({
    type: "resume",
    protocolVersion: "1",
    buildingId: "west-riverside",
    streamId: snapshot.streamId,
    afterSequence: snapshot.sequence,
  })));
  socket.addEventListener("message", (event) => {
    const message = JSON.parse(String(event.data));
    if (message.type !== "event.batch") return;
    if (message.streamId !== snapshot.streamId) process.exit(1);
    if (message.fromSequence !== snapshot.sequence + 1) process.exit(1);
    if (message.toSequence < message.fromSequence) process.exit(1);
    clearTimeout(timeout);
    socket.close();
  });
' "$snapshot_response" "$task_port"

echo "Production smoke test passed"
