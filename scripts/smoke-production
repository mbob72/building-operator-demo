#!/usr/bin/env bash
set -euo pipefail

task_port="4174"
task_log="$(mktemp -t building-operator-production.XXXXXX.log)"
scene_response="$(mktemp -t building-operator-scene.XXXXXX.json)"

PORT="$task_port" HOST="127.0.0.1" NODE_ENV="production" \
  node dist/server/server/index.js >"$task_log" 2>&1 &
server_pid="$!"

cleanup() {
  kill "$server_pid" 2>/dev/null || true
  wait "$server_pid" 2>/dev/null || true
  rm -f "$task_log" "$scene_response"
}
trap cleanup EXIT

ready="false"
for _ in {1..40}; do
  if curl --fail --silent "http://127.0.0.1:${task_port}/api/health" >/dev/null; then
    ready="true"
    break
  fi
  sleep 0.25
done

if [[ "$ready" != "true" ]]; then
  sed -n '1,160p' "$task_log"
  echo "Production server did not become ready" >&2
  exit 1
fi

curl --fail --silent "http://127.0.0.1:${task_port}/" \
  | grep --quiet "Building scene prototype"

curl --fail --silent \
  -H 'content-type: application/json' \
  -d '{"floorId":"west-riverside-level-1","viewport":{"bbox":[0,0,104,98],"width":1200,"height":800},"zoom":5}' \
  "http://127.0.0.1:${task_port}/api/scene/query" \
  -o "$scene_response"

node -e '
  const response = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
  if (response.sceneVersion !== "west-riverside-level-1-v1") process.exit(1);
  if (response.meta.returnedFeatures < 1000) process.exit(1);
' "$scene_response"

echo "Production smoke test passed"
